rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'area']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.role in ['member', 'admin'] &&
        data.area in ['Marketing', 'RRHH', 'Sistemas', 'Administrador'];
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'area', 'color', 'budgetHours', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.area in ['Marketing', 'RRHH', 'Sistemas', 'Administrador'] &&
        data.color is string && data.color.size() <= 30 &&
        data.budgetHours is number && data.budgetHours >= 0 &&
        data.status in ['active', 'archived'];
    }

    function isValidTimeEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userArea', 'projectId', 'projectName', 'description', 'date', 'durationMinutes']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        data.userArea in ['Marketing', 'RRHH', 'Sistemas', 'Administrador'] &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.projectName is string && data.projectName.size() <= 150 &&
        data.description is string && data.description.size() <= 1000 &&
        data.date is string && data.date.size() <= 20 &&
        data.durationMinutes is number && data.durationMinutes >= 0;
    }

    function isValidTimesheet(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userArea', 'weekStartDate', 'weekEndDate', 'status', 'totalMinutes']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        data.userArea in ['Marketing', 'RRHH', 'Sistemas', 'Administrador'] &&
        data.weekStartDate is string && data.weekStartDate.size() <= 20 &&
        data.weekEndDate is string && data.weekEndDate.size() <= 20 &&
        data.status in ['draft', 'submitted', 'approved', 'rejected'] &&
        data.totalMinutes is number && data.totalMinutes >= 0;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(incoming());
      allow delete: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidProject(incoming());
      allow delete: if true;
    }

    // Time entries collection
    match /timeEntries/{entryId} {
      allow read: if true;
      allow create, update: if isValidTimeEntry(incoming());
      allow delete: if true;
    }

    // Timesheets collection
    match /timesheets/{timesheetId} {
      allow read: if true;
      allow create, update: if isValidTimesheet(incoming());
      allow delete: if true;
    }
  }
}
